{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "timeout": 30,
            "command": "\"/Users/shashanksaxena/.local/share/uv/tools/cairn-brain/bin/python3\" -m cairn.capture --platform codex context"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 20,
            "command": "\"/Users/shashanksaxena/.local/share/uv/tools/cairn-brain/bin/python3\" -m cairn.capture --platform codex session-init"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 60,
            "command": "\"/Users/shashanksaxena/.local/share/uv/tools/cairn-brain/bin/python3\" -m cairn.capture --platform codex observation"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "timeout": 60,
            "command": "\"/Users/shashanksaxena/.local/share/uv/tools/cairn-brain/bin/python3\" -m cairn.capture --platform codex summarize"
          }
        ]
      }
    ]
  }
}
