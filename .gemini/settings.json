{
  "mcpServers": {
    "cairn": {
      "command": "cairn",
      "args": [
        "mcp"
      ]
    }
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "name": "cairn",
            "type": "command",
            "timeout": 30000,
            "command": "\"/Users/shashanksaxena/.local/share/uv/tools/cairn-brain/bin/python3\" -m cairn.capture --platform gemini context"
          }
        ]
      }
    ],
    "BeforeAgent": [
      {
        "matcher": "*",
        "hooks": [
          {
            "name": "cairn",
            "type": "command",
            "timeout": 10000,
            "command": "\"/Users/shashanksaxena/.local/share/uv/tools/cairn-brain/bin/python3\" -m cairn.capture --platform gemini session-init"
          }
        ]
      }
    ],
    "AfterTool": [
      {
        "matcher": "*",
        "hooks": [
          {
            "name": "cairn",
            "type": "command",
            "timeout": 10000,
            "command": "\"/Users/shashanksaxena/.local/share/uv/tools/cairn-brain/bin/python3\" -m cairn.capture --platform gemini observation"
          }
        ]
      }
    ],
    "AfterAgent": [
      {
        "matcher": "*",
        "hooks": [
          {
            "name": "cairn",
            "type": "command",
            "timeout": 10000,
            "command": "\"/Users/shashanksaxena/.local/share/uv/tools/cairn-brain/bin/python3\" -m cairn.capture --platform gemini summarize"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "*",
        "hooks": [
          {
            "name": "cairn",
            "type": "command",
            "timeout": 10000,
            "command": "\"/Users/shashanksaxena/.local/share/uv/tools/cairn-brain/bin/python3\" -m cairn.capture --platform gemini session-end"
          }
        ]
      }
    ]
  }
}
