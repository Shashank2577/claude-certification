# Copy to .env.local for local development. On Netlify, set these under Site configuration → Environment variables.

# Postgres connection string (Neon). Leave unset locally to use the embedded PGlite database in ./data/pglite.
# On Netlify, Netlify DB sets NETLIFY_DATABASE_URL (pooled) and NETLIFY_DATABASE_URL_UNPOOLED (direct) for you;
# the app uses DATABASE_URL if set, otherwise NETLIFY_DATABASE_URL.
DATABASE_URL=
# Direct (unpooled) URL for `pnpm db:migrate`. Falls back to NETLIFY_DATABASE_URL_UNPOOLED, then the pooled URLs.
# DATABASE_URL_UNPOOLED=

# Signs session cookies (HS256). Required in production, at least 32 characters.
# Generate one with: openssl rand -base64 48
# Unset in local development → a random secret is generated into data/.auth-secret.
AUTH_SECRET=

# Comma-separated emails that become admins when they sign up. The first account ever created is always an admin.
ADMIN_EMAILS=

# Optional: `pnpm seed` creates or promotes this admin.
# SEED_ADMIN_EMAIL=
# SEED_ADMIN_PASSWORD=
# SEED_ADMIN_NAME=Admin

# Optional: read content from another folder (e.g. content/_sample for the fixtures).
# CONTENT_DIR=content/_sample

# Optional local-only knobs:
# PGLITE_DIR=./data/pglite        # where PGlite keeps its files ("memory://" for an in-memory database)
# NEON_WS_PROXY=localhost:5498    # test the Neon driver against a plain Postgres through a WebSocket tunnel
# INSECURE_COOKIES=1              # allow session cookies over plain HTTP when running `pnpm start` locally
